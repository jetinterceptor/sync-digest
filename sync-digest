name: Sync Daily Aviation Digest to GitHub Pages

on:
  schedule:
    # Runs every 5 minutes (maximum frequency permitted by GitHub Actions cron)
    - cron: '*/5 * * * *'
  repository_dispatch:
    # Fires immediately when triggered by external webhook / Apps Script
    types: [drive-update]
  workflow_dispatch:
    # Allows manual trigger from the GitHub Actions tab

concurrency:
  group: sync-aviation-digest
  cancel-in-progress: true

permissions:
  contents: write
  pages: write
  id-token: write

jobs:
  sync-digest:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Install Dependencies
        run: |
          python -m pip install --upgrade pip
          pip install requests

      - name: Run Drive Sync Engine
        env:
          GDRIVE_FOLDER_ID: "18gA_PGU12sAlcaPeb_phyeK0MGSgnoZQ"
          GDRIVE_API_KEY: ${{ secrets.GDRIVE_API_KEY }}
        run: |
          python scripts/sync_digest.py

      - name: Commit and Push Updates
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          
          if [ -f ".sync_commit_msg.tmp" ]; then
            COMMIT_MSG=$(cat .sync_commit_msg.tmp)
            rm -f .sync_commit_msg.tmp
          else
            COMMIT_MSG="Sync live index.html with latest Google Drive aerospace digest"
          fi
          
          if [[ -n $(git status --porcelain index.html) ]]; then
            echo "Changes detected in index.html. Committing..."
            git add index.html
            git commit -m "$COMMIT_MSG"
            git push origin main
          else
            echo "index.html is already up to date. No commit needed."
          fi
